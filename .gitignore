# Never expose generated artifacts or private operational state via a source exception.
**/target*/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/generated/
**/evidence/
**/output/
**/dist/
**/quarantine/
**/runs/
**/workspaces/
**/.next/
**/.wrangler/
**/.playwright-cli/
**/.butler/
**/.openai/
**/*.tsbuildinfo
**/*.sqlite*
**/*.pyc
**/.env
**/.env.*
!**/.env.example
**/auth.json
**/*.key
**/*.pem
**/*.log
/output/
/target-*/
/generated/
/quarantine/
/tmp/

# Local credentials and provider state.
.env
.env.*
!.env.example
*.pem
*.key
auth.json
.codex/

# Local model/build logs and OS/editor files. JSONL is ignored by local
# operational directory, not by extension, because synthetic replay JSONL is
# a version-controlled conformance input.
/logs/
*.log
.DS_Store
.idea/
.vscode/

# Contract fixtures are always eligible for review and version control. Real
# transcripts, credentials and account data are forbidden in fixtures by the
# Stage 0 provenance policy.
!/fixtures/**/*.jsonl
