        { "profile": "desktop", "availability": "native", "behavior": "Daemon-owned durable schedule." },
        { "profile": "headless", "availability": "native", "behavior": "Host-process durable schedule." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Runs one simulated foreground occurrence." }
      ]
    },
