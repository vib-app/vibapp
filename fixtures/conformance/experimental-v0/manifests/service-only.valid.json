        { "profile": "desktop", "availability": "unavailable", "behavior": "Stage 0 links a typed stub that returns capability-unavailable and performs no network." },
        { "profile": "headless", "availability": "unavailable", "behavior": "Stage 0 links a typed stub that returns capability-unavailable and performs no network." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Returns a captured sample response; no network request occurs." }
