        { "profile": "desktop", "availability": "brokered", "behavior": "Host broker returns CPU temperature when supported." },
        { "profile": "headless", "availability": "brokered", "behavior": "Linux host broker returns CPU temperature when supported." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Returns labeled sample data with simulated=true." }
      ]
    },
    {
      "interface": "vibapp:experimental-v0/http@0.0.1",
      "necessity": "degradable",
      "grant": "user",
      "reason": "POST temperature reports only to the configured telemetry origin.",
