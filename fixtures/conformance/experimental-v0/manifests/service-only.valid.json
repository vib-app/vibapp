      "necessity": "required",
      "grant": "automatic",
      "reason": "Expose bounded diagnostics to GUI and CLI status surfaces.",
      "scope": {},
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "Daemon log stream." },
        { "profile": "headless", "availability": "native", "behavior": "Structured CLI/JSON log stream." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Preview log sink." }
      ]
    },
    {
      "interface": "vibapp:experimental-v0/host-info@0.0.1",
      "necessity": "required",
      "grant": "automatic",
      "reason": "Discover whether capabilities are live or simulated.",
      "scope": {},
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "Reports desktop capability state." },
        { "profile": "headless", "availability": "native", "behavior": "Reports headless capability state." },
        { "profile": "web-preview", "availability": "native", "behavior": "Reports preview mock state." }
      ]
    },
    {
      "interface": "vibapp:experimental-v0/settings@0.0.1",
      "necessity": "required",
      "grant": "automatic",
      "reason": "Read typed endpoint and interval settings persisted by the host.",
      "scope": {},
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "Host-owned settings." },
        { "profile": "headless", "availability": "native", "behavior": "CLI/JSON-managed host settings." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Sample settings." }
      ]
    },
