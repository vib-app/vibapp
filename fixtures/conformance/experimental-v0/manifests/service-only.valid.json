      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "App-scoped daemon storage." },
        { "profile": "headless", "availability": "native", "behavior": "App-scoped host storage." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Disposable preview state." }
      ]
    },
    {
