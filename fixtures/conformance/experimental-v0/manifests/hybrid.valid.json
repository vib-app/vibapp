    {
      "id": "alarm-ui",
      "kind": "launcher-ui",
      "label": "Alarms",
      "profiles": ["desktop", "web-preview"],
      "routes": {
        "initial": "alarms",
        "allowed": ["alarms", "alarm-edit"]
      },
      "restoration": "safe-fields"
    },
    {
      "id": "alarm-service",
      "kind": "service",
      "label": "Alarm Service",
      "profiles": ["desktop", "headless", "web-preview"],
      "triggers": ["on-enable", "scheduler", "manual"],
      "health_check_interval_seconds": 60
    },
    {
      "id": "settings",
      "kind": "settings",
      "label": "Alarm Settings",
      "profiles": ["desktop", "headless", "web-preview"],
      "schema_export": "get-settings-schema"
    }
  ],
  "capabilities": [
    {
      "interface": "vibapp:experimental-v0/clock@0.0.1",
      "necessity": "required",
      "grant": "automatic",
      "reason": "Resolve display and scheduling time semantics.",
      "scope": {},
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "Host clock and time zone." },
        { "profile": "headless", "availability": "native", "behavior": "Headless host clock and time zone." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Deterministic sample clock." }
      ]
    },
    {
      "interface": "vibapp:experimental-v0/scheduler@0.0.1",
      "necessity": "required",
      "grant": "user",
      "reason": "Persist validated alarm schedules and notification projections in the host.",
      "scope": { "maximum_schedules": 128 },
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "Daemon creates due-time notification outbox before guest delivery." },
        { "profile": "headless", "availability": "native", "behavior": "Host process owns schedules; UI is not required." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Simulates one foreground occurrence and labels it preview-only." }
      ]
    },
    {
      "interface": "vibapp:experimental-v0/notification@0.0.1",
      "necessity": "degradable",
      "grant": "user",
      "reason": "Allow explicit immediate test notifications; scheduled alarms use the persisted scheduler projection.",
      "scope": {},
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "Permission-checked OS notification." },
        { "profile": "headless", "availability": "brokered", "behavior": "Host-selected notification adapter when configured." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Displays an in-page sample only." }
      ]
    },
    {
      "interface": "vibapp:experimental-v0/kv@0.0.1",
      "necessity": "required",
      "grant": "automatic",
      "reason": "Persist alarm domain state and occurrence acknowledgements.",
      "scope": { "maximum_storage_bytes": 2097152 },
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "App-scoped daemon state." },
        { "profile": "headless", "availability": "native", "behavior": "App-scoped headless state." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Disposable sample state." }
      ]
    },
    {
      "interface": "vibapp:experimental-v0/log@0.0.1",
      "necessity": "required",
      "grant": "automatic",
      "reason": "Expose bounded lifecycle and delivery diagnostics.",
      "scope": {},
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "Daemon log stream." },
        { "profile": "headless", "availability": "native", "behavior": "CLI/JSON log stream." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Preview log sink." }
      ]
    },
    {
      "interface": "vibapp:experimental-v0/host-info@0.0.1",
      "necessity": "required",
      "grant": "automatic",
      "reason": "Discover current surface and capability degradation.",
      "scope": {},
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "Reports daemon and UI availability." },
        { "profile": "headless", "availability": "native", "behavior": "Reports that UI surfaces are unavailable." },
        { "profile": "web-preview", "availability": "native", "behavior": "Reports preview mocks and foreground-only background semantics." }
      ]
    },
    {
      "interface": "vibapp:experimental-v0/settings@0.0.1",
      "necessity": "required",
      "grant": "automatic",
      "reason": "Read typed quiet-hours and snooze defaults managed by GUI or CLI.",
      "scope": {},
      "profiles": [
        { "profile": "desktop", "availability": "native", "behavior": "Host-rendered settings." },
        { "profile": "headless", "availability": "native", "behavior": "CLI/JSON-managed typed settings." },
        { "profile": "web-preview", "availability": "mock", "behavior": "Sample settings." }
      ]
    }
  ],
