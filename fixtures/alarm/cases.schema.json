{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibapp.local/schemas/stage0/alarm-cases-v1.schema.json",
  "title": "VibApp Stage 0 alarm semantics case matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "platform",
    "constants",
    "wire_contract",
    "wire_examples",
    "coverage_requirements",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "vibapp.alarm-cases.v1" },
    "contract_version": { "const": "vibapp.alarm-semantics.v1" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "kernel", "architecture", "scheduler_owner", "browser_closed_page_excluded"],
      "properties": {
        "os": { "const": "macOS" },
        "os_version": { "const": "26.5.2" },
        "kernel": { "const": "Darwin 25.5.0" },
        "architecture": { "const": "arm64" },
        "scheduler_owner": { "const": "daemon" },
        "browser_closed_page_excluded": { "const": true }
      }
    },
    "constants": { "type": "object" },
    "wire_contract": { "$ref": "#/$defs/wire_contract" },
    "wire_examples": { "$ref": "#/$defs/wire_examples" },
    "coverage_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "utc_instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "local_date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month", "day"],
      "properties": {
        "year": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 }
      }
    },
    "local_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hour", "minute", "second"],
      "properties": {
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "minute": { "type": "integer", "minimum": 0, "maximum": 59 },
        "second": { "type": "integer", "minimum": 0, "maximum": 59 }
      }
    },
    "local_date_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "time", "time_zone"],
      "properties": {
        "date": { "$ref": "#/$defs/local_date" },
        "time": { "$ref": "#/$defs/local_time" },
        "time_zone": { "type": "string", "minLength": 1 }
      }
    },
    "notification_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "standard_sound"],
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "standard_sound": { "type": "boolean" }
      }
    },
    "local_one_shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "gap", "overlap"],
      "properties": {
        "when": { "$ref": "#/$defs/local_date_time" },
        "gap": { "const": "next-valid" },
        "overlap": { "const": "earlier" }
      }
    },
    "local_recurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "time", "start_date", "time_zone", "weekdays", "gap", "overlap"],
      "properties": {
        "kind": { "enum": ["daily", "weekly"] },
        "time": { "$ref": "#/$defs/local_time" },
        "start_date": { "$ref": "#/$defs/local_date" },
        "time_zone": { "type": "string", "minLength": 1 },
        "weekdays": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] }
        },
        "gap": { "const": "next-valid" },
        "overlap": { "const": "earlier" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "daily" } }, "required": ["kind"] },
          "then": { "properties": { "weekdays": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "kind": { "const": "weekly" } }, "required": ["kind"] },
          "then": { "properties": { "weekdays": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "alarm_schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "value"],
          "properties": { "tag": { "const": "one-shot" }, "value": { "$ref": "#/$defs/local_one_shot" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "value"],
          "properties": { "tag": { "const": "recurring" }, "value": { "$ref": "#/$defs/local_recurrence" } }
        }
      ]
    },
    "alarm_configure_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alarm_id", "expected_revision", "schedule", "notification"],
      "properties": {
        "alarm_id": { "type": "string", "minLength": 1 },
        "expected_revision": { "type": ["integer", "null"], "minimum": 0 },
        "schedule": { "$ref": "#/$defs/alarm_schedule" },
        "notification": { "$ref": "#/$defs/notification_projection" }
      }
    },
    "alarm_configure_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "value"],
      "properties": {
        "tag": { "const": "alarm-configure" },
        "value": { "$ref": "#/$defs/alarm_configure_request" }
      }
    },
    "alarm_target_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alarm_id", "expected_revision"],
      "properties": {
        "alarm_id": { "type": "string", "minLength": 1 },
        "expected_revision": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "alarm_snooze_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_occurrence_id", "os_action_id", "action_received_at_utc", "duration_seconds"],
      "properties": {
        "parent_occurrence_id": { "type": "string", "minLength": 1 },
        "os_action_id": { "type": "string", "minLength": 1 },
        "action_received_at_utc": { "$ref": "#/$defs/utc_instant" },
        "duration_seconds": { "type": "integer", "minimum": 60, "maximum": 3600 }
      }
    },
    "alarm_snooze_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "value"],
      "properties": {
        "tag": { "const": "alarm-snooze" },
        "value": { "$ref": "#/$defs/alarm_snooze_request" }
      }
    },
    "alarm_target_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "value"],
      "properties": {
        "tag": { "enum": ["alarm-enable", "alarm-disable", "alarm-cancel"] },
        "value": { "$ref": "#/$defs/alarm_target_request" }
      }
    },
    "alarm_status_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "value"],
      "properties": {
        "tag": { "const": "alarm-status" },
        "value": { "$ref": "#/$defs/alarm_status_request" }
      }
    },
    "app_lifecycle_command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "value"],
          "properties": { "tag": { "const": "disable" }, "value": { "type": "null" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "value"],
          "properties": {
            "tag": { "const": "uninstall" },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["disposition"],
              "properties": { "disposition": { "enum": ["delete", "retain", "export-then-delete"] } }
            }
          }
        }
      ]
    },
    "typed_daemon_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "idempotency_key", "client", "subject", "command"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "client": { "enum": ["launcher", "cli", "web"] },
        "subject": { "type": "string", "minLength": 1 },
        "command": {
          "oneOf": [
            { "$ref": "#/$defs/alarm_configure_command" },
            { "$ref": "#/$defs/alarm_target_command" },
            { "$ref": "#/$defs/alarm_snooze_command" },
            { "$ref": "#/$defs/alarm_status_command" },
            { "$ref": "#/$defs/app_lifecycle_command" }
          ]
        }
      }
    },
    "typed_daemon_request_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "request_ref"],
      "properties": {
        "world": { "enum": ["gui", "cli"] },
        "request_ref": { "enum": ["/wire_examples/gui_alarm_configure", "/wire_examples/cli_alarm_configure"] }
      }
    },
    "daemon_alarm_configure_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "idempotency_key", "client", "subject", "command"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "client": { "enum": ["launcher", "cli"] },
        "subject": { "type": "string", "minLength": 1 },
        "command": { "$ref": "#/$defs/alarm_configure_command" }
      }
    },
    "daemon_alarm_snooze_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "idempotency_key", "client", "subject", "command"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "client": { "enum": ["launcher", "cli"] },
        "subject": { "type": "string", "minLength": 1 },
        "command": { "$ref": "#/$defs/alarm_snooze_command" }
      }
    },
    "alarm_command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alarm_id", "outcome", "revision", "enabled", "next_occurrence_id", "snooze_occurrence_id", "deduplicated"],
      "properties": {
        "alarm_id": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["created", "updated", "enabled", "disabled", "unchanged", "snoozed"] },
        "revision": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" },
        "next_occurrence_id": { "type": ["string", "null"] },
        "snooze_occurrence_id": { "type": ["string", "null"] },
        "deduplicated": { "type": "boolean" }
      }
    },
    "occurrence_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence", "due_at_utc", "state", "classification", "notification_id"],
      "properties": {
        "occurrence": { "type": "string", "minLength": 1 },
        "due_at_utc": { "$ref": "#/$defs/utc_instant" },
        "state": { "enum": ["scheduled", "cancelled", "missed", "permission-denied", "delivery-pending", "notification-accepted", "notification-failed"] },
        "classification": { "type": ["string", "null"], "enum": ["on-time", "catch-up", "missed", "permission-denied", null] },
        "notification_id": { "type": ["string", "null"] }
      }
    },
    "notification_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notification_id", "occurrence", "outcome", "attempts"],
      "properties": {
        "notification_id": { "type": "string", "pattern": "^notify:" },
        "occurrence": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["pending", "accepted", "failed"] },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "guest_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guest_event_id", "occurrence", "outcome", "attempts"],
      "properties": {
        "guest_event_id": { "type": "string", "pattern": "^guest:" },
        "occurrence": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["pending", "acked", "dead-lettered"] },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "snooze_action_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os_action_id", "parent_occurrence_id", "snooze_occurrence_id", "deduplicated"],
      "properties": {
        "os_action_id": { "type": "string", "minLength": 1 },
        "parent_occurrence_id": { "type": "string", "minLength": 1 },
        "snooze_occurrence_id": { "type": "string", "minLength": 1 },
        "deduplicated": { "type": "boolean" }
      }
    },
    "effect_ledger_entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "value"],
          "properties": { "tag": { "const": "notification" }, "value": { "$ref": "#/$defs/notification_effect" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "value"],
          "properties": { "tag": { "const": "guest-event" }, "value": { "$ref": "#/$defs/guest_effect" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "value"],
          "properties": { "tag": { "const": "snooze-action" }, "value": { "$ref": "#/$defs/snooze_action_effect" } }
        }
      ]
    },
    "alarm_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alarm_id", "schedule", "notification", "enabled", "revision", "next_occurrence_id", "occurrences", "occurrences_truncated", "effects", "effects_truncated", "permission_health"],
      "properties": {
        "alarm_id": { "type": "string", "minLength": 1 },
        "schedule": { "$ref": "#/$defs/alarm_schedule" },
        "notification": { "$ref": "#/$defs/notification_projection" },
        "enabled": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0 },
        "next_occurrence_id": { "type": ["string", "null"] },
        "occurrences": { "type": "array", "items": { "$ref": "#/$defs/occurrence_status" } },
        "occurrences_truncated": { "type": "boolean" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect_ledger_entry" } },
        "effects_truncated": { "type": "boolean" },
        "permission_health": { "enum": ["authorized", "denied", "not-determined"] }
      }
    },
    "alarm_status_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "active_generation", "rollback_state", "alarm"],
      "properties": {
        "app": { "type": "string", "minLength": 1 },
        "active_generation": { "type": ["string", "null"] },
        "rollback_state": { "enum": ["none", "observation-window", "rolling-back"] },
        "alarm": { "$ref": "#/$defs/alarm_status" }
      }
    },
    "alarm_status_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alarm_id", "occurrence_limit", "effect_limit"],
      "properties": {
        "alarm_id": { "type": "string", "minLength": 1 },
        "occurrence_limit": { "type": "integer", "minimum": 1 },
        "effect_limit": { "type": "integer", "minimum": 1 }
      }
    },
    "delivery_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "key", "occurrence", "scheduled_for_utc", "dispatched_at_utc", "classification", "attempt", "payload"],
      "properties": {
        "schedule": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "occurrence": { "type": "string", "minLength": 1 },
        "scheduled_for_utc": { "$ref": "#/$defs/utc_instant" },
        "dispatched_at_utc": { "$ref": "#/$defs/utc_instant" },
        "classification": { "enum": ["on-time", "catch-up", "missed", "permission-denied"] },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "payload": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    },
    "wire_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wit_package", "json_mapping", "utc_type", "notification_projection_fields", "local_one_shot_fields", "recurrence_fields", "recurrence_kinds", "alarm_schedule_variants", "delivery_event_fields", "delivery_classifications", "daemon_request_fields", "alarm_control_commands", "alarm_configure_request_fields", "alarm_target_request_fields", "alarm_snooze_request_fields", "alarm_status_request_fields", "alarm_command_result_fields", "alarm_command_outcomes", "occurrence_status_fields", "notification_effect_fields", "notification_effect_outcomes", "guest_effect_fields", "guest_effect_outcomes", "snooze_action_effect_fields", "alarm_status_fields", "alarm_status_snapshot_fields", "permission_health_values", "rollback_state_values", "occurrence_state_values", "effect_variants"],
      "properties": {
        "wit_package": { "const": "vibapp:experimental-v0@0.0.1" },
        "json_mapping": { "const": "wit-kebab-to-snake;record-object;enum-string;option-null-or-value;variant-tag-value;bounded-integer" },
        "utc_type": { "const": "common.utc-instant:YYYY-MM-DDTHH:MM:SSZ" },
        "notification_projection_fields": { "const": ["title", "body", "standard_sound"] },
        "local_one_shot_fields": { "const": ["when", "gap", "overlap"] },
        "recurrence_fields": { "const": ["kind", "time", "start_date", "time_zone", "weekdays", "gap", "overlap"] },
        "recurrence_kinds": { "const": ["daily", "weekly"] },
        "alarm_schedule_variants": { "const": ["one-shot", "recurring"] },
        "delivery_event_fields": { "const": ["schedule", "key", "occurrence", "scheduled_for_utc", "dispatched_at_utc", "classification", "attempt", "payload"] },
        "delivery_classifications": { "const": ["on-time", "catch-up", "missed", "permission-denied"] },
        "daemon_request_fields": { "const": ["request_id", "idempotency_key", "client", "subject", "command"] },
        "alarm_control_commands": { "const": ["alarm-configure", "alarm-enable", "alarm-disable", "alarm-cancel", "alarm-snooze", "alarm-status"] },
        "alarm_configure_request_fields": { "const": ["alarm_id", "expected_revision", "schedule", "notification"] },
        "alarm_target_request_fields": { "const": ["alarm_id", "expected_revision"] },
        "alarm_snooze_request_fields": { "const": ["parent_occurrence_id", "os_action_id", "action_received_at_utc", "duration_seconds"] },
        "alarm_status_request_fields": { "const": ["alarm_id", "occurrence_limit", "effect_limit"] },
        "alarm_command_result_fields": { "const": ["alarm_id", "outcome", "revision", "enabled", "next_occurrence_id", "snooze_occurrence_id", "deduplicated"] },
        "alarm_command_outcomes": { "const": ["created", "updated", "enabled", "disabled", "unchanged", "snoozed"] },
        "occurrence_status_fields": { "const": ["occurrence", "due_at_utc", "state", "classification", "notification_id"] },
        "notification_effect_fields": { "const": ["notification_id", "occurrence", "outcome", "attempts"] },
        "notification_effect_outcomes": { "const": ["pending", "accepted", "failed"] },
        "guest_effect_fields": { "const": ["guest_event_id", "occurrence", "outcome", "attempts"] },
        "guest_effect_outcomes": { "const": ["pending", "acked", "dead-lettered"] },
        "snooze_action_effect_fields": { "const": ["os_action_id", "parent_occurrence_id", "snooze_occurrence_id", "deduplicated"] },
        "alarm_status_fields": { "const": ["alarm_id", "schedule", "notification", "enabled", "revision", "next_occurrence_id", "occurrences", "occurrences_truncated", "effects", "effects_truncated", "permission_health"] },
        "alarm_status_snapshot_fields": { "const": ["app", "active_generation", "rollback_state", "alarm"] },
        "permission_health_values": { "const": ["authorized", "denied", "not-determined"] },
        "rollback_state_values": { "const": ["none", "observation-window", "rolling-back"] },
        "occurrence_state_values": { "const": ["scheduled", "cancelled", "missed", "permission-denied", "delivery-pending", "notification-accepted", "notification-failed"] },
        "effect_variants": { "const": ["notification", "guest-event", "snooze-action"] }
      }
    },
    "wire_examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notification_projection", "daily_recurrence", "weekly_recurrence", "gui_alarm_configure", "cli_alarm_configure", "alarm_snooze_request", "alarm_snooze_daemon_request", "alarm_command_result", "alarm_status_request", "alarm_status_snapshot", "delivery_events"],
      "properties": {
        "notification_projection": { "$ref": "#/$defs/notification_projection" },
        "daily_recurrence": { "$ref": "#/$defs/local_recurrence" },
        "weekly_recurrence": { "$ref": "#/$defs/local_recurrence" },
        "gui_alarm_configure": { "$ref": "#/$defs/daemon_alarm_configure_request" },
        "cli_alarm_configure": { "$ref": "#/$defs/daemon_alarm_configure_request" },
        "alarm_snooze_request": { "$ref": "#/$defs/alarm_snooze_request" },
        "alarm_snooze_daemon_request": { "$ref": "#/$defs/daemon_alarm_snooze_request" },
        "alarm_command_result": { "$ref": "#/$defs/alarm_command_result" },
        "alarm_status_request": { "$ref": "#/$defs/alarm_status_request" },
        "alarm_status_snapshot": { "$ref": "#/$defs/alarm_status_snapshot" },
        "delivery_events": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/delivery_event" }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_utc", "type", "data"],
      "properties": {
        "at_utc": { "$ref": "#/$defs/utc_instant" },
        "type": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "typed-daemon-request" } }, "required": ["type"] },
          "then": {
            "properties": {
              "data": {
                "oneOf": [
                  { "$ref": "#/$defs/typed_daemon_request" },
                  { "$ref": "#/$defs/typed_daemon_request_ref" }
                ]
              }
            }
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "value": {}
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notification_id", "occurrence_id", "logical_count", "outcome", "adapter_attempts"],
      "properties": {
        "notification_id": { "type": "string", "pattern": "^notify:" },
        "occurrence_id": { "type": "string", "minLength": 1 },
        "logical_count": { "const": 1 },
        "outcome": { "enum": ["accepted", "failed"] },
        "adapter_attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at_utc", "result"],
            "properties": {
              "at_utc": { "$ref": "#/$defs/utc_instant" },
              "result": { "enum": ["accepted", "transient-failure", "permanent-failure", "acceptance-unknown"] }
            }
          }
        }
      }
    },
    "guest_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guest_event_id", "occurrence_id", "scheduled_for_utc", "dispatched_at_utc", "classification", "outcome", "attempts"],
      "properties": {
        "guest_event_id": { "type": "string", "pattern": "^guest:" },
        "occurrence_id": { "type": "string", "minLength": 1 },
        "scheduled_for_utc": { "$ref": "#/$defs/utc_instant" },
        "dispatched_at_utc": { "$ref": "#/$defs/utc_instant" },
        "classification": { "enum": ["on-time", "catch-up", "missed", "permission-denied"] },
        "outcome": { "enum": ["acked", "dead-lettered", "pending"] },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persisted_state",
        "notifications",
        "guest_events",
        "deduplication_keys",
        "rollback_result",
        "active_generation",
        "scheduler_owner",
        "launcher_state"
      ],
      "properties": {
        "persisted_state": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "notifications": {
          "type": "array",
          "items": { "$ref": "#/$defs/notification" }
        },
        "guest_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/guest_event" }
        },
        "deduplication_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rollback_result": { "type": "string", "minLength": 1 },
        "active_generation": { "type": ["string", "null"] },
        "scheduler_owner": { "const": "daemon" },
        "launcher_state": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "requirement_tags", "given", "events", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "description": { "type": "string", "minLength": 1 },
        "requirement_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "given": { "type": "object" },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event" }
        },
        "expected": { "$ref": "#/$defs/expected" }
      }
    }
  }
}
