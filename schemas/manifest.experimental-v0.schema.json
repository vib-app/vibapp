{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibapp.ai/schemas/manifest.experimental-v0.schema.json",
  "title": "VibApp experimental-v0 manifest",
  "description": "Unpublished Stage 0 manifest. Schema validity is necessary but semantic conformance checks in RFC 0001 are also mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_format",
    "app",
    "artifacts",
    "runtime",
    "entrypoints",
    "capabilities",
    "resources",
    "state",
    "lifecycle",
    "source",
    "license",
    "privacy",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "vibapp.manifest.experimental-v0.0.1" },
    "package_format": { "const": "vibapp.package.experimental-v0" },
    "app": { "$ref": "#/$defs/app" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/entrypoint" }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/capability" }
    },
    "resources": { "$ref": "#/$defs/resources" },
    "state": { "$ref": "#/$defs/state" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "source": { "$ref": "#/$defs/source" },
    "license": { "$ref": "#/$defs/license" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "verification": { "$ref": "#/$defs/verification" }
  },
  "allOf": [
    {
      "if": { "properties": { "app": { "type": "object", "properties": { "kind": { "const": "ui" } }, "required": ["kind"] } } },
      "then": {
        "properties": {
          "runtime": { "type": "object", "properties": { "world": { "const": "ui-only-reference" } } },
          "entrypoints": {
            "type": "array",
            "contains": { "type": "object", "properties": { "kind": { "const": "launcher-ui" } }, "required": ["kind"] },
            "minContains": 1,
            "allOf": [
              {
                "not": {
                  "contains": { "type": "object", "properties": { "kind": { "const": "service" } }, "required": ["kind"] }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "app": { "type": "object", "properties": { "kind": { "const": "service" } }, "required": ["kind"] } } },
      "then": {
        "properties": {
          "runtime": { "type": "object", "properties": { "world": { "enum": ["service-only-reference", "web-preview-reference"] } } },
          "entrypoints": {
            "type": "array",
            "contains": { "type": "object", "properties": { "kind": { "const": "service" } }, "required": ["kind"] },
            "minContains": 1,
            "allOf": [
              {
                "not": {
                  "contains": { "type": "object", "properties": { "kind": { "const": "launcher-ui" } }, "required": ["kind"] }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "app": { "type": "object", "properties": { "kind": { "const": "hybrid" } }, "required": ["kind"] } } },
      "then": {
        "properties": {
          "runtime": { "type": "object", "properties": { "world": { "const": "hybrid-reference" } } },
          "entrypoints": {
            "type": "array",
            "allOf": [
              {
                "contains": { "type": "object", "properties": { "kind": { "const": "launcher-ui" } }, "required": ["kind"] },
                "minContains": 1
              },
              {
                "contains": { "type": "object", "properties": { "kind": { "const": "service" } }, "required": ["kind"] },
                "minContains": 1
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "wit-interface": {
      "type": "string",
      "enum": [
        "vibapp:experimental-v0/clock@0.0.1",
        "vibapp:experimental-v0/scheduler@0.0.1",
        "vibapp:experimental-v0/notification@0.0.1",
        "vibapp:experimental-v0/kv@0.0.1",
        "vibapp:experimental-v0/log@0.0.1",
        "vibapp:experimental-v0/host-info@0.0.1",
        "vibapp:experimental-v0/settings@0.0.1",
        "vibapp:experimental-v0/system-metrics@0.0.1",
        "vibapp:experimental-v0/http@0.0.1"
      ]
    },
    "profile-name": {
      "enum": ["desktop", "web-preview", "web-runtime", "headless"]
    },
    "artifact-path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "sha256", "size_bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/artifact-path" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 }
      }
    },
    "canonical-component": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "type": "object",
          "properties": {
            "path": { "const": "component.wasm" },
            "media_type": { "const": "application/wasm" }
          }
        }
      ]
    },
    "derived-artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "format", "derived_from_sha256", "entry", "files", "derivation_attestation"],
      "properties": {
        "profile": { "enum": ["web-preview", "web-runtime"] },
        "format": { "const": "jco-esm" },
        "derived_from_sha256": { "$ref": "#/$defs/sha256" },
        "entry": { "$ref": "#/$defs/artifact" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "derivation_attestation": { "$ref": "#/$defs/artifact" }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "display_name", "description", "publisher"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" },
        "kind": { "enum": ["ui", "service", "hybrid"] },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "display_name"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "display_name": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_component", "assets", "browser_derivations", "provenance", "sbom"],
      "properties": {
        "canonical_component": { "$ref": "#/$defs/canonical-component" },
        "assets": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "browser_derivations": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/derived-artifact" }
        },
        "provenance": { "$ref": "#/$defs/artifact" },
        "sbom": { "$ref": "#/$defs/artifact" }
      }
    },
    "profile-support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "mode", "background", "artifact_role", "degradation"],
      "properties": {
        "profile": { "$ref": "#/$defs/profile-name" },
        "mode": { "enum": ["full", "degraded", "preview"] },
        "background": { "enum": ["daemon", "process", "foreground-only", "not-applicable"] },
        "artifact_role": { "enum": ["canonical-component", "browser-derived"] },
        "degradation": { "type": "string", "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "profile": { "const": "web-preview" } }, "required": ["profile"] },
          "then": {
            "properties": {
              "mode": { "const": "preview" },
              "background": { "const": "foreground-only" },
              "artifact_role": { "const": "browser-derived" }
            }
          }
        },
        {
          "if": { "properties": { "profile": { "const": "web-runtime" } }, "required": ["profile"] },
          "then": {
            "properties": {
              "background": { "const": "foreground-only" },
              "artifact_role": { "const": "browser-derived" }
            }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "wasi", "world", "required_imports", "profiles", "platforms"],
      "properties": {
        "contract": { "const": "vibapp:experimental-v0@0.0.1" },
        "wasi": { "const": "0.2" },
        "world": { "enum": ["ui-only-reference", "service-only-reference", "hybrid-reference", "web-preview-reference"] },
        "required_imports": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/wit-interface" }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/profile-support" }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/platform-support" }
        }
      }
    },
    "platform-support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "profiles"],
      "properties": {
        "os": { "enum": ["macos", "windows", "linux", "browser"] },
        "arch": { "enum": ["x86-64", "aarch64", "wasm32"] },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile-name" }
        }
      }
    },
    "launcher-entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "profiles", "routes", "restoration"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "launcher-ui" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/profile-name" } },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial", "allowed"],
          "properties": {
            "initial": { "$ref": "#/$defs/identifier" },
            "allowed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
          }
        },
        "restoration": { "enum": ["none", "route-only", "safe-fields"] }
      }
    },
    "service-entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "profiles", "triggers", "health_check_interval_seconds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "service" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/profile-name" } },
        "triggers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["on-enable", "scheduler", "manual"] } },
        "health_check_interval_seconds": { "type": "integer", "minimum": 10, "maximum": 86400 }
      }
    },
    "settings-entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "profiles", "schema_export"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "settings" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/profile-name" } },
        "schema_export": { "const": "get-settings-schema" }
      }
    },
    "entrypoint": {
      "oneOf": [
        { "$ref": "#/$defs/launcher-entrypoint" },
        { "$ref": "#/$defs/service-entrypoint" },
        { "$ref": "#/$defs/settings-entrypoint" }
      ]
    },
    "capability-profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "availability", "behavior"],
      "properties": {
        "profile": { "$ref": "#/$defs/profile-name" },
        "availability": { "enum": ["native", "brokered", "mock", "denied", "unavailable"] },
        "behavior": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "capability-scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origins": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[^/?#\\s]+$" } },
        "methods": { "type": "array", "uniqueItems": true, "items": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] } },
        "metrics": { "type": "array", "uniqueItems": true, "items": { "enum": ["cpu-temperature-celsius", "cpu-utilization-percent", "memory-utilization-percent"] } },
        "maximum_schedules": { "type": "integer", "minimum": 0, "maximum": 128 },
        "maximum_requests_per_hour": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maximum_storage_bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "necessity", "grant", "reason", "scope", "profiles"],
      "properties": {
        "interface": { "$ref": "#/$defs/wit-interface" },
        "necessity": { "enum": ["required", "degradable"] },
        "grant": { "enum": ["automatic", "user"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "scope": { "$ref": "#/$defs/capability-scope" },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/capability-profile" } }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linear_memory_bytes", "event_wall_time_ms", "health_migration_wall_time_ms", "output_bytes", "stored_data_bytes", "durable_schedules", "log_bytes_per_day"],
      "properties": {
        "linear_memory_bytes": { "type": "integer", "minimum": 1048576, "maximum": 67108864 },
        "event_wall_time_ms": { "type": "integer", "minimum": 1, "maximum": 250 },
        "health_migration_wall_time_ms": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "output_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "stored_data_bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "durable_schedules": { "type": "integer", "minimum": 0, "maximum": 128 },
        "log_bytes_per_day": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "migratable_from_min", "migratable_from_max"],
      "properties": {
        "schema": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "migratable_from_min": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "migratable_from_max": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disable", "uninstall"],
      "properties": {
        "disable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retains_package", "retains_state", "stops_services", "cancels_schedules"],
          "properties": {
            "retains_package": { "const": true },
            "retains_state": { "const": true },
            "stops_services": { "const": true },
            "cancels_schedules": { "const": true }
          }
        },
        "uninstall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_data_dispositions", "default_data_disposition"],
          "properties": {
            "allowed_data_dispositions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["delete", "retain", "export-then-delete"] }
            },
            "default_data_disposition": { "enum": ["delete", "retain", "export-then-delete"] }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "revision", "cargo_lock_sha256", "builder_image_digest"],
      "properties": {
        "language": { "const": "rust" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "cargo_lock_sha256": { "$ref": "#/$defs/sha256" },
        "builder_image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_expression"],
      "properties": {
        "spdx_expression": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stores_personal_data", "network_access"],
      "properties": {
        "stores_personal_data": { "type": "boolean" },
        "network_access": { "enum": ["none", "scoped-broker"] }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "revocation"],
      "properties": {
        "status": { "enum": ["fixture", "unverified", "verified"] },
        "revocation": { "enum": ["not-revoked", "revoked"] }
      }
    }
  }
}
