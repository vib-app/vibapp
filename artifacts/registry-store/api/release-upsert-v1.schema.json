{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibapp.ai/schemas/registry-store/release-upsert-v1.schema.json",
  "title": "VibApp Registry immutable release ingestion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "app", "publisher", "contract", "compatibility", "capabilities", "source", "search_metadata", "embedding"],
  "properties": {
    "schema_version": {"const": "vibapp.registry-release-upsert.experimental.2026-08-24.1"},
    "record_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "display_name", "summary", "package_digest_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "kind": {"enum": ["ui", "service", "hybrid"]},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "package_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher_id", "display_name"],
      "properties": {
        "publisher_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_format", "component_contract", "wasi", "wit_world", "manifest_digest_sha256"],
      "properties": {
        "package_format": {"const": "vibapp.package.experimental-v0"},
        "component_contract": {"const": "vibapp:experimental-v0@0.0.1"},
        "wasi": {"const": "0.2"},
        "wit_world": {"enum": ["ui-only-reference", "service-only-reference", "hybrid-reference", "web-preview-reference"]},
        "manifest_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles", "platforms"],
      "properties": {
        "profiles": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["desktop", "web-preview", "web-runtime", "headless"]}},
        "platforms": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["os", "arch", "profile"],
            "properties": {
              "os": {"enum": ["macos", "windows", "linux", "browser"]},
              "arch": {"enum": ["aarch64", "x86-64", "wasm32"]},
              "profile": {"enum": ["desktop", "web-preview", "web-runtime", "headless"]}
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["interface", "necessity", "grant", "scope_digest_sha256", "summary"],
        "properties": {
          "interface": {"type": "string", "minLength": 1, "maxLength": 200},
          "necessity": {"enum": ["required", "degradable"]},
          "grant": {"enum": ["automatic", "user"]},
          "scope_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["visibility", "license_spdx", "source_digest_sha256", "sbom_digest_sha256", "provenance_digest_sha256"],
      "properties": {
        "visibility": {"enum": ["private", "public"]},
        "license_spdx": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sbom_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "search_metadata": {
      "type": "object", "additionalProperties": false, "required": ["tags", "capability_labels"],
      "properties": {
        "tags": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "capability_labels": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
      }
    },
    "embedding": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_version", "dimensions", "content_digest_sha256", "vector"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "dimensions": {"const": 384},
        "content_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "vector": {"type": "array", "minItems": 384, "maxItems": 384, "items": {"type": "number"}}
      }
    }
  }
}
