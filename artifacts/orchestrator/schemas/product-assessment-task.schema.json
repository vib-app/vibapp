{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibapp.ai/schemas/experimental/product-assessment-task.experimental-v1.schema.json",
  "title": "VibApp durable product capability assessment task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "task_kind",
    "task_id",
    "need_id",
    "reason_code",
    "status",
    "assessment_digest_sha256",
    "need_spec_binding",
    "requirement_summary",
    "attempt_count",
    "current_attempt_id",
    "attempt_ids",
    "codeagent_task_created",
    "external_request_made",
    "provider_process_started",
    "created_at_utc",
    "updated_at_utc"
  ],
  "properties": {
    "schema_version": { "const": "vibapp.product-assessment-task.experimental-v1" },
    "document_type": { "const": "product-assessment-task" },
    "task_kind": { "const": "product-assessment" },
    "task_id": { "$ref": "#/$defs/task_id" },
    "need_id": { "$ref": "#/$defs/need_id" },
    "reason_code": { "const": "unsupported-capability-combination" },
    "status": { "const": "unsupported" },
    "assessment_digest_sha256": { "$ref": "#/$defs/sha256" },
    "need_spec_binding": { "$ref": "#/$defs/need_spec_binding" },
    "requirement_summary": { "$ref": "#/$defs/requirement_summary" },
    "attempt_count": { "const": 1 },
    "current_attempt_id": { "$ref": "#/$defs/attempt_id" },
    "attempt_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/attempt_id" }
    },
    "codeagent_task_created": { "const": false },
    "external_request_made": { "const": false },
    "provider_process_started": { "const": false },
    "created_at_utc": { "$ref": "#/$defs/utc" },
    "updated_at_utc": { "$ref": "#/$defs/utc" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_id": { "type": "string", "pattern": "^assessment-[0-9a-f]{32}$" },
    "attempt_id": { "type": "string", "pattern": "^assessment-attempt-0001-[0-9a-f]{16}$" },
    "need_id": { "type": "string", "pattern": "^need-[0-9A-Fa-f]{1,32}$" },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "bounded_values": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "need_spec_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "need_id",
        "revision",
        "state",
        "canonical_digest_sha256",
        "source_relative_path"
      ],
      "properties": {
        "schema_version": { "const": "vibapp.need-spec.product-v0.0.1" },
        "need_id": { "$ref": "#/$defs/need_id" },
        "revision": { "type": "integer", "minimum": 1 },
        "state": { "const": "draft" },
        "canonical_digest_sha256": { "$ref": "#/$defs/sha256" },
        "source_relative_path": {
          "type": "string",
          "minLength": 24,
          "maxLength": 256,
          "pattern": "^registry-requests/[A-Za-z0-9._-]+\\.json$"
        }
      }
    },
    "requirement_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "goal",
        "package_id",
        "requested_app_kind",
        "requested_capabilities",
        "requested_allowed_permissions",
        "requested_forbidden_permissions",
        "request_values_truncated",
        "network_mode",
        "completion_request_digest_sha256"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "package_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requested_app_kind": { "type": "string", "minLength": 1, "maxLength": 32 },
        "requested_capabilities": { "$ref": "#/$defs/bounded_values" },
        "requested_allowed_permissions": { "$ref": "#/$defs/bounded_values" },
        "requested_forbidden_permissions": { "$ref": "#/$defs/bounded_values" },
        "request_values_truncated": { "type": "boolean" },
        "network_mode": { "type": "string", "minLength": 1, "maxLength": 32 },
        "completion_request_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
