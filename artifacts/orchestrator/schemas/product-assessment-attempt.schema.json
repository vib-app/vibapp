{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibapp.ai/schemas/experimental/product-assessment-attempt.experimental-v1.schema.json",
  "title": "VibApp terminal product capability assessment attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "task_kind",
    "task_id",
    "attempt_id",
    "attempt_number",
    "need_id",
    "reason_code",
    "status",
    "stage",
    "progress_percent",
    "terminal",
    "assessment_digest_sha256",
    "need_spec_binding",
    "requirement_summary",
    "reasons",
    "codeagent_task_created",
    "external_request_made",
    "provider_process_started",
    "authorities",
    "created_at_utc",
    "updated_at_utc"
  ],
  "properties": {
    "schema_version": { "const": "vibapp.product-assessment-attempt.experimental-v1" },
    "document_type": { "const": "product-assessment-attempt" },
    "task_kind": { "const": "product-assessment" },
    "task_id": { "$ref": "product-assessment-task.experimental-v1.schema.json#/$defs/task_id" },
    "attempt_id": { "$ref": "product-assessment-task.experimental-v1.schema.json#/$defs/attempt_id" },
    "attempt_number": { "const": 1 },
    "need_id": { "$ref": "product-assessment-task.experimental-v1.schema.json#/$defs/need_id" },
    "reason_code": { "const": "unsupported-capability-combination" },
    "status": { "const": "unsupported" },
    "stage": { "const": "product-capability-assessment" },
    "progress_percent": { "const": 100 },
    "terminal": { "const": true },
    "assessment_digest_sha256": { "$ref": "product-assessment-task.experimental-v1.schema.json#/$defs/sha256" },
    "need_spec_binding": { "$ref": "product-assessment-task.experimental-v1.schema.json#/$defs/need_spec_binding" },
    "requirement_summary": { "$ref": "product-assessment-task.experimental-v1.schema.json#/$defs/requirement_summary" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "codeagent_task_created": { "const": false },
    "external_request_made": { "const": false },
    "provider_process_started": { "const": false },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codeagent", "provider", "builder", "verifier", "publication"],
      "properties": {
        "codeagent": { "const": "not-invoked" },
        "provider": { "const": "not-invoked" },
        "builder": { "const": "not-invoked" },
        "verifier": { "const": "not-invoked" },
        "publication": { "const": "not-performed" }
      }
    },
    "created_at_utc": { "$ref": "product-assessment-task.experimental-v1.schema.json#/$defs/utc" },
    "updated_at_utc": { "$ref": "product-assessment-task.experimental-v1.schema.json#/$defs/utc" }
  }
}
