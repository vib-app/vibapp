{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibapp.ai/schemas/experimental/provider-runner-synthetic-report.experimental-v1.schema.json",
  "title": "Non-live provider runner lifecycle report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "job_id",
    "status",
    "input_bundle_sha256",
    "output_bundle_sha256",
    "executable_sha256",
    "isolate_id",
    "allocated_uid",
    "allocated_gid",
    "identity_enforcement",
    "system_uid",
    "minimal_environment_keys",
    "external_request_attempted",
    "external_request_observed",
    "gateway_request_id",
    "whole_job_quiescent",
    "exit_code",
    "stdout_bytes",
    "stderr_bytes",
    "rejected_code"
  ],
  "properties": {
    "schema_version": {"const": "vibapp.provider-runner-synthetic-report.experimental-v1"},
    "document_type": {"const": "provider-runner-synthetic-report"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"enum": ["synthetic-pass", "synthetic-rejected"]},
    "input_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_bundle_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "isolate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "allocated_uid": {"type": "integer", "minimum": 200000, "maximum": 599999},
    "allocated_gid": {"type": "integer", "minimum": 200000, "maximum": 599999},
    "identity_enforcement": {"const": "synthetic-label-only"},
    "system_uid": {"type": "integer", "minimum": 0},
    "minimal_environment_keys": {"type": "array", "maxItems": 16, "items": {"type": "string"}, "uniqueItems": true},
    "external_request_attempted": {"const": false},
    "external_request_observed": {"const": false},
    "gateway_request_id": {"const": null},
    "whole_job_quiescent": {"type": "boolean"},
    "exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
    "stdout_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
    "stderr_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
    "rejected_code": {"type": ["string", "null"]}
  }
}
