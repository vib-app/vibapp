{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibapp.ai/schemas/experimental/verifier-decision.experimental-v1.schema.json",
  "title": "Independent verifier rejection decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "state",
    "receipt_reference_sha256",
    "quarantine_receipt_sha256",
    "error",
    "candidate_created",
    "decided_at_utc",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": "vibapp.verifier-decision.experimental-v1" },
    "document_type": { "const": "verifier-decision" },
    "state": { "const": "rejected" },
    "receipt_reference_sha256": { "$ref": "#/$defs/sha256" },
    "quarantine_receipt_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "candidate_created": { "const": false },
    "decided_at_utc": { "$ref": "#/$defs/utc" },
    "authority": {
      "const": {
        "verify": "independent-verifier",
        "install": "none",
        "publish": "none"
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
