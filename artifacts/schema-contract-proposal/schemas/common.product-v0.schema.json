{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibapp.ai/schemas/product-v0/common.product-v0.schema.json",
  "title": "VibApp product-v0 common candidate definitions",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tagged_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "app_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "utc_instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "app_kind": {
      "enum": ["ui", "service", "hybrid"]
    },
    "execution_profile": {
      "enum": ["desktop", "web-preview", "web-runtime", "headless"]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "profile"],
      "properties": {
        "os": { "enum": ["macos", "windows", "linux", "browser"] },
        "arch": { "enum": ["aarch64", "x86-64", "wasm32"] },
        "profile": { "$ref": "#/$defs/execution_profile" }
      }
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "principal_kind"],
      "properties": {
        "principal_id": { "$ref": "#/$defs/identifier" },
        "principal_kind": { "enum": ["user", "service", "auditor"] }
      }
    },
    "publisher_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher_id", "display_name", "verification_state"],
      "properties": {
        "publisher_id": { "$ref": "#/$defs/app_identifier" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "verification_state": { "enum": ["unverified", "verified", "suspended"] }
      }
    },
    "package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_id", "version", "package_digest_sha256", "manifest_digest_sha256"],
      "properties": {
        "app_id": { "$ref": "#/$defs/app_identifier" },
        "version": { "$ref": "#/$defs/semver" },
        "package_digest_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes", "media_type", "visibility"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "visibility": { "enum": ["private", "public"] }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "sha256"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": [
            "manifest", "component", "provenance", "sbom", "scan", "verifier-report",
            "runtime-observation", "network-capture", "consent-record", "audit-record",
            "screenshot", "video", "browser-trace", "installer", "daemon-binary"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "permission_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "necessity", "scope_digest_sha256", "summary"],
      "properties": {
        "interface": { "type": "string", "minLength": 1, "maxLength": 200 },
        "necessity": { "enum": ["required", "degradable"] },
        "scope_digest_sha256": { "$ref": "#/$defs/sha256" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "invalid-argument", "not-found", "conflict", "forbidden", "consent-required",
            "stale-revision", "expired", "integrity-failure", "resource-limit",
            "cancelled", "internal"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
