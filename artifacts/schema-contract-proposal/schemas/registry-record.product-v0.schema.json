{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibapp.ai/schemas/product-v0/registry-record.product-v0.schema.json",
  "title": "VibApp immutable Registry record candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_type", "record_id", "record_revision", "app",
    "package", "contract", "compatibility", "permissions", "source", "verification",
    "publication", "search_metadata", "created_at_utc"
  ],
  "properties": {
    "schema_version": { "const": "vibapp.registry-record.product-v0.0.1" },
    "document_type": { "const": "registry-record" },
    "record_id": { "$ref": "common.product-v0.schema.json#/$defs/identifier" },
    "record_revision": { "type": "integer", "minimum": 1 },
    "app": { "$ref": "#/$defs/app" },
    "package": { "$ref": "common.product-v0.schema.json#/$defs/package_ref" },
    "contract": { "$ref": "#/$defs/contract" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "common.product-v0.schema.json#/$defs/permission_requirement" }
    },
    "source": { "$ref": "#/$defs/source" },
    "verification": { "$ref": "#/$defs/verification" },
    "publication": { "$ref": "#/$defs/publication" },
    "search_metadata": { "$ref": "#/$defs/search_metadata" },
    "created_at_utc": { "$ref": "common.product-v0.schema.json#/$defs/utc_instant" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication": {
            "properties": { "state": { "const": "published" } },
            "required": ["state"]
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "status": { "const": "verified" },
              "revocation": { "const": "not-revoked" }
            },
            "required": ["status", "revocation"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": { "revocation": { "const": "revoked" } },
            "required": ["revocation"]
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "properties": { "state": { "const": "revoked" } },
            "required": ["state"]
          }
        }
      }
    }
  ],
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "display_name", "summary", "publisher"],
      "properties": {
        "id": { "$ref": "common.product-v0.schema.json#/$defs/app_identifier" },
        "version": { "$ref": "common.product-v0.schema.json#/$defs/semver" },
        "kind": { "$ref": "common.product-v0.schema.json#/$defs/app_kind" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "publisher": { "$ref": "common.product-v0.schema.json#/$defs/publisher_ref" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_format", "component_contract", "wasi", "wit_world"],
      "properties": {
        "package_format": { "type": "string", "minLength": 1, "maxLength": 128 },
        "component_contract": { "type": "string", "minLength": 1, "maxLength": 200 },
        "wasi": { "type": "string", "minLength": 1, "maxLength": 32 },
        "wit_world": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "profiles"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "common.product-v0.schema.json#/$defs/platform" }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "common.product-v0.schema.json#/$defs/execution_profile" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "source_digest_sha256", "license_spdx"],
      "properties": {
        "visibility": { "enum": ["private", "public"] },
        "source_digest_sha256": { "$ref": "common.product-v0.schema.json#/$defs/sha256" },
        "license_spdx": { "type": "string", "minLength": 1, "maxLength": 200 },
        "github_archive": { "$ref": "#/$defs/github_archive" }
      }
    },
    "github_archive": {
      "description": "Trusted archive-service receipt. Mandatory for real public projection; optional only for legacy/private/synthetic records. Shape alone does not grant publication authority.",
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "repository", "repository_id", "commit_sha", "source_digest_sha256", "package_digest_sha256"],
      "properties": {
        "organization": { "const": "vib-app" },
        "repository": { "type": "string", "pattern": "^app-[0-9a-f]{64}$" },
        "repository_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_digest_sha256": { "$ref": "common.product-v0.schema.json#/$defs/sha256" },
        "package_digest_sha256": { "$ref": "common.product-v0.schema.json#/$defs/sha256" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "revocation", "evidence", "provenance", "sbom", "scan"],
      "properties": {
        "status": { "enum": ["unverified", "verified"] },
        "revocation": { "enum": ["not-revoked", "revoked"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "common.product-v0.schema.json#/$defs/evidence_ref" }
        },
        "provenance": { "$ref": "common.product-v0.schema.json#/$defs/artifact_ref" },
        "sbom": { "$ref": "common.product-v0.schema.json#/$defs/artifact_ref" },
        "scan": { "$ref": "common.product-v0.schema.json#/$defs/artifact_ref" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "published_at_utc", "revoked_at_utc", "public_metadata_digest_sha256"],
      "properties": {
        "state": { "enum": ["draft", "quarantined", "published", "revoked"] },
        "published_at_utc": {
          "anyOf": [
            { "$ref": "common.product-v0.schema.json#/$defs/utc_instant" },
            { "type": "null" }
          ]
        },
        "revoked_at_utc": {
          "anyOf": [
            { "$ref": "common.product-v0.schema.json#/$defs/utc_instant" },
            { "type": "null" }
          ]
        },
        "public_metadata_digest_sha256": {
          "anyOf": [
            { "$ref": "common.product-v0.schema.json#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "search_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags", "capability_labels", "search_text_digest_sha256"],
      "properties": {
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "capability_labels": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "search_text_digest_sha256": { "$ref": "common.product-v0.schema.json#/$defs/sha256" }
      }
    }
  }
}
